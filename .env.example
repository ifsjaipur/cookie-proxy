PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# SQLite path (mount a volume here in Coolify so keys persist).
DB_PATH=/data/cookie-proxy.db

# Browser pool sizing — set based on VPS RAM. ~300MB per active context.
MAX_BROWSERS=4

# How long a host's cookies stay cached before re-solving (ms).
COOKIE_TTL_MS=1200000

# Per-request timeouts.
NAV_TIMEOUT_MS=45000
CHALLENGE_WAIT_MS=8000

# Override only if you need to spoof a different browser fingerprint.
# USER_AGENT=Mozilla/5.0 (...)
